<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.runner-fleet.cleanup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Adjust the path to your fleet root -->
        <string>cd "$HOME/actions-runners" &amp;&amp; ./cleanup.sh --apply --auto &gt;&gt; "$HOME/Library/Logs/fleet-cleanup.log" 2&gt;&amp;1</string>
    </array>

    <!-- Every 15 minutes. --auto exits after one df unless the disk is under the
         pressure line or a day has passed since the last full run. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>
