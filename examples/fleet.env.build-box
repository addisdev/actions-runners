# A dedicated CI build box joining a fleet as an agent, then (later) taking over
# as coordinator and primary. Untracked once copied; nothing secret lives here.
#
#   scripts/bootstrap-host.sh --peer <current-host> --apply --only fleet-env
#       writes ~/actions-runners/fleet.env from this file, filling the lines
#       marked COPIED from the peer's own fleet.env, and the host id from
#       this Mac's local host name. It never overwrites an existing fleet.env.
#   scripts/join-host.sh                       # dry run, then --apply --only <repos>
#
# The agent token goes in its own mode-600 file:
#   on the coordinator:  ./dashboard/fleetctl.sh agent-token --host <this host id>

# --- identity -------------------------------------------------------------------
# Set from `scutil --get LocalHostName` (set it in System Settings before the
# first registration: runner names are <host>-<repo>, never renamed afterwards).
FLEET_HOST_ID=@HOST_ID@
FLEET_HOST_NAME=@HOST_ID@
FLEET_LABEL_PREFIX=@COPIED@
FLEET_OWNER=@COPIED@
# The coordinator as THIS host reaches it (LAN name or IP). The coordinator must
# list this host's name and address in its own FLEET_ALLOWED_HOSTS.
FLEET_COORDINATOR=@COORDINATOR@
FLEET_AGENT_TOKEN_FILE=@ROOT@/dashboard/.fleet-agent-token-file
FLEET_ADMIT_STATUS_URL=@COORDINATOR@/api/run-status

# --- what this host can run (COPIED) ----------------------------------------------
# The same labels as the peer: the box is built to the same toolchain by
# bootstrap-host.sh and proven by host-manifest.sh --diff before any runner
# registers. A label is a promise; drop one here if its toolchain is not there.
FLEET_HOST_LABELS=@COPIED@
FLEET_MIRROR_SKIP_REPOS=""
FLEET_XCODE_VERSION=@COPIED@
FLEET_SIMULATOR_RUNNERS=@COPIED@
FLEET_ADMIT_HEAVY_PATTERNS=@COPIED@
# The hand-off routing label (one host carries it; see docs/claude/promote-coordinator.md)
# stays on the coordinator. Do not add it here before the promotion.

# --- capacity ---------------------------------------------------------------------
# The agent's own cap on how many runners this host may hold. A mirror of the
# coordinator's runners is about as many as it has, plus second instances.
FLEET_MAX_TOTAL_RUNNERS=100
FLEET_CEILING=6

# --- job admission: the first day's caps -------------------------------------------
# Heavy 4 / light 12 / total 14 / simulator 2 to prove the box; heavy 6, total 18
# only after a day of evidence (swap, pressure, no lost runners).
FLEET_ADMIT_MODE=enforce
FLEET_ADMIT_MAX_CONCURRENT=8
FLEET_ADMIT_LANES=enforce
FLEET_ADMIT_TOTAL_MAX_CONCURRENT=14
FLEET_ADMIT_HEAVY_MAX_CONCURRENT=4
FLEET_ADMIT_LIGHT_MAX_CONCURRENT=12
FLEET_ADMIT_SIMULATOR_MAX_CONCURRENT=2
FLEET_ADMIT_SHORT_JOB_S=90
FLEET_ADMIT_MAX_WAIT_S=600
FLEET_ADMIT_TIMEOUT_ACTION=hold
FLEET_ADMIT_CANCEL_POLL_S=30
# A 2 TB CI-only disk: hold jobs under 150 GB, clean under 300, so the work
# trees keep their DerivedData, venvs and Gradle caches warm.
FLEET_ADMIT_MIN_FREE_DISK_GB=150
FLEET_CLEANUP_PRESSURE_GB=300
FLEET_SIMULATOR_CLEANUP=1

# --- remote control from the coordinator: stage 1, reports only -------------------
FLEET_AGENT_ALLOW_COMMANDS=0
FLEET_AGENT_ALLOW_REGISTER=0
FLEET_AGENT_ALLOW_DEREGISTER=0

# --- not here ---------------------------------------------------------------------
# No night cap: it protects the coordinator host's own night work, and this box
# has none. No tiers until it is the coordinator (promote-coordinator.md).
