# Environment for agent.js on a remote (non-coordinator) Mac.
#
# Set these before starting agent.js, either in the shell or in the
# LaunchAgent plist (see launchd-agent.plist).
#
# Get the agent token from the coordinator:
#   ssh user@coordinator-mac 'cat ~/actions-runners/dashboard/.fleet-agent-token'

FLEET_COORDINATOR=http://coordinator-mac:7878
FLEET_AGENT_TOKEN=<paste-token-here>
FLEET_HOST_NAME=mac-studio            # shown in the Hosts tab

# Optional: allow the coordinator to send remote commands (drain/resume/health)
# FLEET_AGENT_ALLOW_COMMANDS=1

# Capacity limits for this host. Must match what the hardware can actually do.
# FLEET_MAX_TOTAL_RUNNERS=8
# FLEET_CEILING=3
# FLEET_LOAD_PER_CORE=0.7
# FLEET_MIN_FREE_DISK_GB=20
