# fleet.env for the coordinator Mac in a federated setup.
#
# The coordinator runs fleetd.js and the main fleet.db.
# It must be reachable from agent Macs (set FLEET_HOST to bind to the LAN).

# Bind to all interfaces so agents can reach the dashboard.
# Only do this if the host is on a trusted LAN or behind a firewall.
FLEET_HOST=0.0.0.0

# Set a ceiling that reflects the coordinator host's own capacity.
# FLEET_CEILING=3
# FLEET_MAX_TOTAL_RUNNERS=8

# Admission control — gates execution across ALL runners on this host.
# FLEET_ADMIT_MODE=enforce
# FLEET_ADMIT_MAX_CONCURRENT=3
# FLEET_ADMIT_MAX_WAIT_S=600
