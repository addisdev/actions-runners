# fleet.env for a single-host setup.
#
# Copy to ~/actions-runners/fleet.env and uncomment what you need.
# Most single-host setups need none of these — groups are inferred, the owner
# comes from `gh`, and repos come from the runner directories.

# Pin the groups you look at most to the top, in this order.
# FLEET_PROJECTS="project backend"

# Never form a group for these tokens even if two repos share them.
# FLEET_GROUP_IGNORE="template scratch"

# Job admission — off by default, observe before enforcing.
# FLEET_ADMIT_MODE=observe
# FLEET_ADMIT_MAX_CONCURRENT=3
# FLEET_ADMIT_MAX_WAIT_S=600
# FLEET_ADMIT_MIN_FREE_DISK_GB=40

# Concurrency ceiling (set before first install to seed the dashboard setting).
# FLEET_CEILING=3
