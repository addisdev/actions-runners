# A second runner host that shares the coordinator's repos.
#
#   cp examples/fleet.env.second-host fleet.env    # then edit the four marked lines
#   scripts/join-host.sh                            # dry run: what it would do
#   scripts/join-host.sh --apply
#
# No secret lives in this file. The agent token goes in its own mode-600 file:
#   on the coordinator:  ./dashboard/fleetctl.sh agent-token --host build-mac-2
#   here:                umask 077; pbpaste > ~/actions-runners/dashboard/.fleet-agent-token-file

# Must match the coordinator's prefix only if you want the same LaunchAgent
# naming on every host; it is per host.
FLEET_LABEL_PREFIX=com.runner-fleet

# --- identity (edit) -----------------------------------------------------------
# Stable: scopes the agent token and routes commands. Never rename it.
FLEET_HOST_ID=build-mac-2
FLEET_HOST_NAME=build-mac-2
# The coordinator's address as THIS host reaches it. The coordinator must list
# that name or IP in its own FLEET_ALLOWED_HOSTS.
FLEET_COORDINATOR=http://coordinator-mac:7878
FLEET_AGENT_TOKEN_FILE=/Users/you/actions-runners/dashboard/.fleet-agent-token-file

# --- what this host can run (edit) ---------------------------------------------
# A label here is a promise: the placer and mirror-runners.sh copy every runner
# whose extra labels are all listed. Leave out a label until its toolchain or
# service is installed AND safe to use from CI (a `postgres` label means jobs
# may create and drop databases on this host's server).
FLEET_HOST_LABELS=ci,ui-web
# Repos whose jobs need something no label states: an iOS lane on a plain `ci`
# runner, a backend suite that expects a local database. Bare names or owner/repo.
FLEET_MIRROR_SKIP_REPOS=""
# The Xcode every host builds with (xcodebuild -version). join-host.sh refuses
# to go on when this host's differs: a job's SDK must not depend on which host
# GitHub picked. Leave unset on a fleet without Apple jobs.
#FLEET_XCODE_VERSION=27.0

# --- capacity ------------------------------------------------------------------
FLEET_MAX_TOTAL_RUNNERS=70
FLEET_CEILING=6

# --- job admission (hooks/job-started.sh) ---------------------------------------
# Per host: each host counts its own running jobs.
FLEET_ADMIT_MODE=enforce
FLEET_ADMIT_MAX_CONCURRENT=6
FLEET_ADMIT_SIMULATOR_MAX_CONCURRENT=2
FLEET_ADMIT_SHORT_JOB_S=90
FLEET_ADMIT_SHORT_MAX_CONCURRENT=4
FLEET_ADMIT_MAX_WAIT_S=600
FLEET_ADMIT_TIMEOUT_ACTION=hold
FLEET_ADMIT_CANCEL_POLL_S=30
# No fleetd runs here, so ask the coordinator whether a held job's run was
# cancelled. Empty skips the lookup and falls back to gh/curl.
FLEET_ADMIT_STATUS_URL=http://coordinator-mac:7878/api/run-status

FLEET_SIMULATOR_CLEANUP=1
FLEET_SIMULATOR_RUNNERS="*-ios *-ios-* *-tvos *-tvos-*"

# --- remote control from the coordinator (opt in later) --------------------------
FLEET_AGENT_ALLOW_COMMANDS=0
FLEET_AGENT_ALLOW_REGISTER=0
FLEET_AGENT_ALLOW_DEREGISTER=0
