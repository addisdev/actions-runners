# Copy to fleet.env to use. That filename is ignored, because everything in here
# is specific to one host or one GitHub account.
#
# Every variable is optional, and on a normal runner host you need none of
# them: repos are read from the runner directories, groups are inferred from
# the repo names, and the owner comes from `gh`. What is left here is for
# overriding those when they get it wrong, plus the one value that genuinely
# cannot be derived (the launchd label prefix).
#
# PRECEDENCE: this file is sourced by the scripts, so it WINS over whatever is
# already in the environment. `FLEET_REPOS='a b' ./runs.sh` will not override a
# FLEET_REPOS set below — comment it out here instead.

# Prefix for the LaunchAgent labels of the three daemons (dashboard, autofix,
# watch), which become <prefix>.fleet-dashboard and so on.
#
# Set this BEFORE installing, and do not change it afterwards without
# reinstalling. launchctl identifies a loaded job by the label it was installed
# under, so editing this while agents are loaded leaves them running under the
# old label while the ctl scripts look for the new one — status and restart then
# report "not loaded" for a daemon that is working fine.
#FLEET_LABEL_PREFIX=com.runner-fleet

# GitHub owner — a user or an org — for repos referred to by bare name.
# Defaults to whoever `gh` is authenticated as.
#FLEET_OWNER=your-github-username

# Explicit repo list for runs.sh, whitespace- or newline-separated. Bare names
# get FLEET_OWNER prepended; owner/repo is taken as given.
#
# You almost certainly do not need this. On a runner host the list comes from
# the runner directories; on a machine with no runners, runs.sh asks `gh` which
# of the account's repos have Actions and caches the answer. Set this only to
# watch a specific subset, or repos belonging to someone else.
#FLEET_REPOS="my-ios-app my-web-app other-owner/shared-lib"

# Where runs.sh caches the discovered repo list, and for how long (seconds).
# The default is 6 hours, on the grounds that the answer changes when someone
# creates a repo while `--watch` asks the question every 15 seconds.
# `runs.sh --refresh` rediscovers now, whatever the age.
#FLEET_REPO_CACHE=.fleet-repos
#FLEET_REPO_CACHE_TTL=21600

# How many of the account's repos discovery will consider. Raise it for an
# account with more than 200.
#FLEET_REPO_LIMIT=200

# --- grouping -----------------------------------------------------------------
#
# The dashboard groups runners and repos so that app-ios/app-web/app-backend
# appear together under "app". This is INFERRED by default and needs no
# configuration: any first token shared by two or more repo names becomes a
# group, and repos that share nothing land under "other". The four variables
# below only exist for when the inference gets it wrong.

# Force these groups into existence and show them first, in this order.
# Everything inferred follows. Matched as a prefix, not a token, so "app" also
# claims "app2-web"; the longest matching pin wins.
#
# Use this to pin the two or three groups you look at most to the top, or to
# create a group whose repos do not share a prefix.
#FLEET_PROJECTS="app otherapp"

# Never infer these groups. Their repos fall through to "other".
#
# Worth setting for a token that is shared by accident rather than by
# convention — a `template-*` set of scaffolds, for instance, which is a real
# shared prefix but not a thing anyone wants a heading for.
#FLEET_GROUP_IGNORE="template scratch"

# How many repos must share a token before it becomes a group. Default 2.
# Raise it if a couple of unrelated repos keep forming a heading you do not
# want; ignoring that one token is usually the better fix.
#FLEET_GROUP_MIN=2

# Set to "off" to disable grouping entirely and show one flat list, which is
# the right answer for a handful of unrelated repos.
#FLEET_GROUPS=off

# ---------------------------------------------------------------------------
# Capacity and autoscaling live in the dashboard, not here
# ---------------------------------------------------------------------------
#
# The concurrency ceiling, the per-repo runner limit, the idle TTL and the
# autoscaler's on/off and dry-run switches are all editable on the dashboard's
# Capacity tab, and take effect on the next collector tick with no restart.
#
# PRECEDENCE, because it is the opposite of what you might expect: a value set
# here SEEDS the setting, it does not override it. Once a setting has been
# edited in the UI, the stored value wins and changing this file has no further
# effect on it until the row is reset from that tab. Anything else would mean a
# value edited in the UI silently reverting on the next restart.
#
# The tab shows which of the three layers — stored setting, this file, or the
# built-in default — each value came from.

# The one capacity knob it is worth seeding from here, because it decides how
# much of the machine CI may take and you may want it set before first boot.
# Default 3: on a 12-core host, two concurrent jobs already put the load average
# at five times the core count.
#FLEET_CEILING=3

# ---------------------------------------------------------------------------
# Job admission control — the one limit that applies to RUNNING jobs
# ---------------------------------------------------------------------------
#
# FLEET_CEILING above refuses to ADD a runner. It cannot stop a burst across
# runners that already exist: every runner listens independently, so if 29 of
# them are offered work in the same second, 29 jobs start. That is how this host
# recorded a load average of 760.
#
# These settings gate job EXECUTION, from hooks/job-started.sh. They must live
# in this file rather than on the Capacity tab: the hooks run inside a CI job's
# environment and cannot read the dashboard's database or reach its API, and
# making a job's ability to start depend on the daemon being alive would be a
# worse failure mode than the thrashing it prevents.
#
# Requires the hooks to be installed in each runner's .env:
#   scripts/install-hooks.sh --apply --restart

# off      — the default. The hooks exit immediately and nothing changes.
# observe  — never delays a job, but records what enforcing WOULD have done.
#            Run here first: the Capacity tab shows every decision, so the limit
#            can be judged before it is able to cost a build.
# enforce  — holds a job until there is room.
#FLEET_ADMIT_MODE=observe

# How many jobs may run at once. Default 3, matching FLEET_CEILING and for the
# same measured reason — median load1 on this host is 60 at two concurrent jobs
# and 91 at three.
#FLEET_ADMIT_MAX_CONCURRENT=3

# Optional stricter limit for Apple Simulator runners. Matching uses the same
# space-separated shell patterns as FLEET_SIMULATOR_RUNNERS below. This lets a
# host run (for example) one Xcode job plus one backend job while preventing two
# Xcode jobs from starving CoreSimulator's launch watchdogs. Zero disables it.
#FLEET_ADMIT_SIMULATOR_MAX_CONCURRENT=0

# How long a job may be held before the timeout action below. A held job is IN
# PROGRESS as far as GitHub is concerned, so this counts against its own
# `timeout-minutes`.
#FLEET_ADMIT_MAX_WAIT_S=600

# `admit` preserves fail-open behaviour after max-wait. `hold` keeps the host
# limit strict and lets the job's own timeout/cancellation end the wait.
#FLEET_ADMIT_TIMEOUT_ACTION=admit

# Poll GitHub this often while held. This is what releases a runner when a
# cancelled run does not interrupt the sleeping job-started hook. Minimum 5s.
#FLEET_ADMIT_CANCEL_POLL_S=30

# Refuse to start a job when the disk is this low, so a build fails on a clear
# reason rather than halfway through a link step. Matches minFreeDiskGb on the
# Capacity tab. Unlike the concurrency limit, waiting does not fix this unless
# cleanup.sh runs, so it relies on the bound above. Playwright browser caches
# can consume several GB per runner — keep FLEET_ADMIT_MIN_FREE_DISK_GB high
# enough to absorb an install mid-job.
#FLEET_ADMIT_MIN_FREE_DISK_GB=40

# How often a held job re-checks. Rarely worth changing.
#FLEET_ADMIT_POLL_S=5

# Mutex spin attempts per wait-loop tick in enforce mode. The outer loop retries
# every FLEET_ADMIT_POLL_S; keep this modest so timeout and cancellation checks
# stay on wall-clock time. Enforce mode no longer bypasses the limit when the
# mutex is briefly contended.
#FLEET_ADMIT_MUTEX_TRIES=50

# Eligible held jobs are admitted FIFO. A Simulator waiter blocked by the
# Simulator-specific limit does not prevent an unrelated waiter from using free
# host capacity. Abandoned entries are reaped by hook-PID liveness.

# A slot whose owning Runner.Worker is gone is reclaimed immediately by PID
# check; this is the backstop for a PID that a reboot recycled. Six hours was
# GitHub's own default job ceiling.
#FLEET_ADMIT_SLOT_TTL_S=21600
# Shared path used by both job hooks and fleetd for admission decisions.
#FLEET_ADMISSION_LOG=/Users/you/actions-runners/dashboard/logs/admission.ndjson

# ---------------------------------------------------------------------------
# Periodic health repair (silent runner death)
# ---------------------------------------------------------------------------
#
# Runner LaunchAgents do not set KeepAlive. When RunnerService.js dies, launchd
# leaves the job loaded but dead and one repo's jobs queue forever. health.sh
# --repair fixes that; healthctl.sh installs a LaunchAgent to run it on a timer.
#
# Interval in seconds between repair sweeps. Default 60. Install or reinstall
# after changing: ./healthctl.sh install
#FLEET_HEALTH_INTERVAL=60
#
# Optional override for the repair log path. Default: logs/fleet-health-repair.log
# under FLEET_ROOT.
#FLEET_HEALTH_LOG=/path/to/fleet-health-repair.log

# The independent fleet watchdog always records outage/recovery transitions.
# Set this before `dashboard/watch/watchctl.sh install` to also post a local
# macOS notification when fleetd is unreachable and when it recovers.
#WATCH_NOTIFY=1

# Loopback status endpoint for the separate autofix bridge. The dashboard proxies
# this read-only response so the UI can show paused/disabled remediation state.
#FLEET_AUTOFIX_STATUS_URL=http://127.0.0.1:7879/status

# ---------------------------------------------------------------------------
# Database backups and metrics
# ---------------------------------------------------------------------------
#
# Back up fleet.db before upgrades. Online backup is safe while fleetd runs:
#   cd dashboard && ./fleetctl.sh backup
# Restore requires stopping the daemon first:
#   ./fleetctl.sh stop && ./fleetctl.sh restore backups/fleet-YYYYMMDD-HHMMSS.db
#
# Where timestamped backups are written (mode 0600). Default: dashboard/backups/
#FLEET_BACKUP_DIR=/path/to/backups
#
# Snapshot age after which /api/health reports stale and Prometheus metrics
# mark the collector stale. Default 240000 (4 minutes).
#FLEET_COLLECTOR_STALE_MS=240000

# Shared control-plane state and automatic leader election. Leave unset for the
# normal single-coordinator SQLite mode. Put the PostgreSQL URL in this mode-0600
# file on each Mac rather than embedding a password in a LaunchAgent plist.
#FLEET_DATABASE_URL_FILE=/Users/you/actions-runners/dashboard/.fleet-database-url
#FLEET_DATABASE_SSL=1
#FLEET_DATABASE_SSL_INSECURE=0
# Stable and unique on every Mac.
#FLEET_REPLICA_ID=mac-mini-1

# ---------------------------------------------------------------------------
# Federation — multi-host coordinator and agent settings
# ---------------------------------------------------------------------------
#
# Single-host deployments need none of these. Set them to add agents and let
# the coordinator place new runners across multiple Macs.

# ---------------------------------------------------------------------------
# Remote access and mobile
# ---------------------------------------------------------------------------

# Bind address. Default 127.0.0.1 (loopback only — use SSH tunnel to reach it
# from another machine). Set to 0.0.0.0 to accept connections on the LAN.
# Use ./fleetctl.sh remote lan on|off to toggle without editing this file.
# Never expose this port to the public internet — use Tailscale Serve or a VPN.
#FLEET_HOST=0.0.0.0

# Extra host names or IPs that the Host-header allowlist should accept.
# Comma-separated. Add custom DNS names, reverse-proxy hostnames, etc.
#FLEET_ALLOWED_HOSTS=my-mac.example.com,192.168.1.50

# Path to the per-device token store (JSON, mode 0600). Each paired device gets
# its own revokable token; the master control token never leaves this machine.
# Use ./fleetctl.sh pair to generate a pairing code for a new device.
#FLEET_DEVICE_TOKENS_FILE=/path/to/.fleet-device-tokens.json

# ---------------------------------------------------------------------------
# ---- Coordinator settings --------------------------------------------------

# Network address the coordinator listens on (same as FLEET_HOST above).
# Listed again here for clarity in federation deployments.
#FLEET_HOST=127.0.0.1

# Capability labels that THIS coordinator host can satisfy. Used by the
# placement engine to route jobs that require specific software versions.
# Comma-separated, no spaces around commas.
#   FLEET_HOST_LABELS=xcode-16,macos-15
#FLEET_HOST_LABELS=

# Separate token for agent heartbeats. Falls back to the control token if
# unset. Use this to rotate agent credentials without invalidating the browser
# token, or to give agents a less-privileged token.
# Generate: ./dashboard/fleetctl.sh agent-token
#FLEET_AGENT_TOKEN_FILE=/path/to/.fleet-agent-token
#
# Recommended for multiple hosts: one scoped token per host. The coordinator
# stores only SHA-256 hashes in this mode-0600 JSON file.
# Generate: ./dashboard/fleetctl.sh agent-token --host mac-studio-1
#FLEET_AGENT_TOKENS_FILE=/path/to/.fleet-agent-tokens.json

# ---- Agent settings (on agent Macs, not the coordinator) ------------------

# URL of the coordinator (set on agent hosts, not the coordinator itself).
#FLEET_COORDINATOR=http://coordinator-mac:7878
# HA: ordered comma-separated endpoints. The agent fails over automatically.
#FLEET_COORDINATORS=http://mac-mini:7878,http://mac-studio:7878

# Token the agent uses to authenticate to the coordinator.
# Generate on the coordinator:
#   ./dashboard/fleetctl.sh agent-token --host mac-studio-1
#FLEET_AGENT_TOKEN=<paste token here>

# Stable token-scope and command-routing ID. Keep this unchanged across renames.
#FLEET_HOST_ID=mac-studio-1

# Display name for this host in the Hosts tab.
#FLEET_HOST_NAME=mac-studio-1

# Capability labels this agent host can satisfy. Same format as coordinator.
#FLEET_HOST_LABELS=xcode-16,macos-15

# Allow the coordinator to send drain/resume/health-check commands.
# Safe default is 0 (report-only).
#FLEET_AGENT_ALLOW_COMMANDS=0

# Allow the coordinator to register new runners on this host (implies
# FLEET_AGENT_ALLOW_COMMANDS=1). Set to 1 to enable remote provisioning.
# The agent re-checks local headroom and the per-repo cap before invoking
# register.sh, and treats an already-present runner as success (idempotent).
#FLEET_AGENT_ALLOW_REGISTER=0

# Destructive and separately opt-in: permit remote scale-down/deregistration.
#FLEET_AGENT_ALLOW_DEREGISTER=0

# Must match the coordinator's maxInstancesPerRepo setting.
#FLEET_MAX_INSTANCES_PER_REPO=4

# How often the agent sends a heartbeat (milliseconds). Default 30 000 (30s).
#FLEET_HEARTBEAT_MS=30000
#
# Multi-host rollout (recommended order):
#   1. Coordinator: install, set FLEET_HOST_LABELS, ./fleetctl.sh agent-token
#   2. One agent: FLEET_COORDINATOR + FLEET_AGENT_TOKEN + matching labels
#   3. Confirm Hosts tab heartbeats before FLEET_AGENT_ALLOW_COMMANDS=1
#   4. Enable autoscale dry-run, then live; remote register last
#
# Warm capacity / pre-warming: adding runners raises concurrency, not CPU.
# Headroom gates (FLEET_CEILING, FLEET_MAX_TOTAL_RUNNERS) still apply on each
# host. Forecast pre-warming stays locked until evaluation gates pass and never
# bypasses headroom or per-repo caps — see docs/design/capacity.md.

# ---------------------------------------------------------------------------
# Job audio — mute host output for simulator jobs
# ---------------------------------------------------------------------------
#
# Exact runner names, separated by spaces or commas. Apple simulators have no
# supported per-device mute and route app audio through the Mac. The job hooks
# save the host's mute state, mute before the first step, and restore after the
# last selected job. A guardian also restores it if a cancelled job skips its
# completed hook. Empty by default.
#FLEET_MUTE_RUNNERS="my-app-tvos"

# Shut down simulators created by selected CI runners after their final
# overlapping job finishes. Devices that were already booted before CI began
# are preserved. A Runner.Worker guardian performs the same cleanup when a
# cancellation or crash skips the completed hook.
#FLEET_SIMULATOR_CLEANUP=0
#FLEET_SIMULATOR_RUNNERS="*-ios *-ios-* *-tvos *-tvos-*"
