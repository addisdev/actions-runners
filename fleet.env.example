# Copy to fleet.env to use. That filename is ignored, because everything in here
# is specific to one host or one GitHub account.
#
# Every variable is optional, and on a normal runner host you need none of
# them: repos are read from the runner directories, groups are inferred from
# the repo names, and the owner comes from `gh`. What is left here is for
# overriding those when they get it wrong, plus the one value that genuinely
# cannot be derived (the launchd label prefix).
#
# PRECEDENCE: this file is sourced by the scripts, so it WINS over whatever is
# already in the environment. `FLEET_REPOS='a b' ./runs.sh` will not override a
# FLEET_REPOS set below — comment it out here instead.

# Prefix for the LaunchAgent labels of the three daemons (dashboard, autofix,
# watch), which become <prefix>.fleet-dashboard and so on.
#
# Set this BEFORE installing, and do not change it afterwards without
# reinstalling. launchctl identifies a loaded job by the label it was installed
# under, so editing this while agents are loaded leaves them running under the
# old label while the ctl scripts look for the new one — status and restart then
# report "not loaded" for a daemon that is working fine.
#FLEET_LABEL_PREFIX=com.runner-fleet

# GitHub owner — a user or an org — for repos referred to by bare name.
# Defaults to whoever `gh` is authenticated as.
#FLEET_OWNER=your-github-username

# Explicit repo list for runs.sh, whitespace- or newline-separated. Bare names
# get FLEET_OWNER prepended; owner/repo is taken as given.
#
# You almost certainly do not need this. On a runner host the list comes from
# the runner directories; on a machine with no runners, runs.sh asks `gh` which
# of the account's repos have Actions and caches the answer. Set this only to
# watch a specific subset, or repos belonging to someone else.
#FLEET_REPOS="my-ios-app my-web-app other-owner/shared-lib"

# Where runs.sh caches the discovered repo list, and for how long (seconds).
# The default is 6 hours, on the grounds that the answer changes when someone
# creates a repo while `--watch` asks the question every 15 seconds.
# `runs.sh --refresh` rediscovers now, whatever the age.
#FLEET_REPO_CACHE=.fleet-repos
#FLEET_REPO_CACHE_TTL=21600

# How many of the account's repos discovery will consider. Raise it for an
# account with more than 200.
#FLEET_REPO_LIMIT=200

# --- grouping -----------------------------------------------------------------
#
# The dashboard groups runners and repos so that app-ios/app-web/app-backend
# appear together under "app". This is INFERRED by default and needs no
# configuration: any first token shared by two or more repo names becomes a
# group, and repos that share nothing land under "other". The four variables
# below only exist for when the inference gets it wrong.

# Force these groups into existence and show them first, in this order.
# Everything inferred follows. Matched as a prefix, not a token, so "app" also
# claims "app2-web"; the longest matching pin wins.
#
# Use this to pin the two or three groups you look at most to the top, or to
# create a group whose repos do not share a prefix.
#FLEET_PROJECTS="app otherapp"

# Never infer these groups. Their repos fall through to "other".
#
# Worth setting for a token that is shared by accident rather than by
# convention — a `template-*` set of scaffolds, for instance, which is a real
# shared prefix but not a thing anyone wants a heading for.
#FLEET_GROUP_IGNORE="template scratch"

# How many repos must share a token before it becomes a group. Default 2.
# Raise it if a couple of unrelated repos keep forming a heading you do not
# want; ignoring that one token is usually the better fix.
#FLEET_GROUP_MIN=2

# Set to "off" to disable grouping entirely and show one flat list, which is
# the right answer for a handful of unrelated repos.
#FLEET_GROUPS=off

# ---------------------------------------------------------------------------
# Capacity and autoscaling live in the dashboard, not here
# ---------------------------------------------------------------------------
#
# The concurrency ceiling, the per-repo runner limit, the idle TTL and the
# autoscaler's on/off and dry-run switches are all editable on the dashboard's
# Capacity tab, and take effect on the next collector tick with no restart.
#
# PRECEDENCE, because it is the opposite of what you might expect: a value set
# here SEEDS the setting, it does not override it. Once a setting has been
# edited in the UI, the stored value wins and changing this file has no further
# effect on it until the row is reset from that tab. Anything else would mean a
# value edited in the UI silently reverting on the next restart.
#
# The tab shows which of the three layers — stored setting, this file, or the
# built-in default — each value came from.

# The one capacity knob it is worth seeding from here, because it decides how
# much of the machine CI may take and you may want it set before first boot.
# Default 3: on a 12-core host, two concurrent jobs already put the load average
# at five times the core count.
#FLEET_CEILING=3

# ---------------------------------------------------------------------------
# Job admission control — the one limit that applies to RUNNING jobs
# ---------------------------------------------------------------------------
#
# FLEET_CEILING above refuses to ADD a runner. It cannot stop a burst across
# runners that already exist: every runner listens independently, so if 29 of
# them are offered work in the same second, 29 jobs start. That is how this host
# recorded a load average of 760.
#
# These settings gate job EXECUTION, from hooks/job-started.sh. They must live
# in this file rather than on the Capacity tab: the hooks run inside a CI job's
# environment and cannot read the dashboard's database or reach its API, and
# making a job's ability to start depend on the daemon being alive would be a
# worse failure mode than the thrashing it prevents.
#
# Requires the hooks to be installed in each runner's .env:
#   scripts/install-hooks.sh --apply --restart

# off      — the default. The hooks exit immediately and nothing changes.
# observe  — never delays a job, but records what enforcing WOULD have done.
#            Run here first: the Capacity tab shows every decision, so the limit
#            can be judged before it is able to cost a build.
# enforce  — holds a job until there is room.
#FLEET_ADMIT_MODE=observe

# How many jobs may run at once. Default 3, matching FLEET_CEILING and for the
# same measured reason — median load1 on this host is 60 at two concurrent jobs
# and 91 at three.
#FLEET_ADMIT_MAX_CONCURRENT=3

# How long a job may be held before it is admitted anyway. This bound is not
# optional: a held job is IN PROGRESS as far as GitHub is concerned, so the wait
# counts against that job's own `timeout-minutes`. An unbounded hold turns a
# queue into a failed build.
#FLEET_ADMIT_MAX_WAIT_S=600

# Refuse to start a job when the disk is this low, so a build fails on a clear
# reason rather than halfway through a link step. Matches minFreeDiskGb on the
# Capacity tab. Unlike the concurrency limit, waiting does not fix this unless
# cleanup.sh runs, so it relies on the bound above.
#FLEET_ADMIT_MIN_FREE_DISK_GB=40

# How often a held job re-checks. Rarely worth changing.
#FLEET_ADMIT_POLL_S=5

# A slot whose owning Runner.Worker is gone is reclaimed immediately by PID
# check; this is the backstop for a PID that a reboot recycled. Six hours was
# GitHub's own default job ceiling.
#FLEET_ADMIT_SLOT_TTL_S=21600
